{
  "name": "ab-elements-app",
  "version": "0.2.25",
  "description": "abElements is the home of every Ab package: docs, live examples, and an installable PWA, built with the same packages it documents.",
  "private": true,
  "homepage": "https://ab-elements.vercel.app/",
  "keywords": [
    "free",
    "ui",
    "elements",
    "nextjs",
    "react",
