    "lit",
    "flutter",
    "components",
    "abraham",
    "ukachi",
    "ab-nextjs-components",
    "ab-react-components",
    "ab-vue-components",
    "ab-lit-components",
    "ab-flutter-components"
  ],
  "author": {
    "name": "Abraham Ukachi",
    "url": "https://github.com/abraham-ukachi",
    "email": "abraham.ukachi@laplateforme.io"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:no-eval": "node scripts/check-no-eval.mjs",
