    "ab-nextjs-fonts": "0.2.7",
    "ab-nextjs-hooks": "0.1.7",
    "ab-nextjs-i18n": "0.1.0",
    "ab-nextjs-icons": "0.2.7",
    "ab-nextjs-theme": "0.3.9",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "next": "16.3.4",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
